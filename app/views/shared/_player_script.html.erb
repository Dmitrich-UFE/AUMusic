<script>
(function() {
  window.App = window.App || {};
  if (typeof ActionCable !== "undefined" && !App.cable) {
    App.cable = ActionCable.createConsumer();
  }

  // Глобальное постоянное хранилище состояния плеера (не сбрасывается при переходах Turbo)
  window.auPlayerState = window.auPlayerState || {
    hasActiveTrack: false,
    playlist: [],
    currentIndex: 0,
    reactionSubscription: null
  };
  const state = window.auPlayerState;

  function formatTime(secs) {
    const m = Math.floor(secs / 60);
    const s = Math.floor(secs % 60);
    return m + ":" + (s < 10 ? "0" : "") + s;
  }

  function updateReactionIcons(userReactionKind) {
    const minPlayerContainer = document.getElementById("au-player-minimized-container");
    if (!minPlayerContainer) return;

    const assetLike = minPlayerContainer.getAttribute("data-img-like");
    const assetLikeConfirmed = minPlayerContainer.getAttribute("data-img-like-confirmed");
    const assetDislike = minPlayerContainer.getAttribute("data-img-dislike");
    const assetDislikeConfirmed = minPlayerContainer.getAttribute("data-img-dislike-confirmed");

    const minLikeImg = document.querySelector("#min-like-btn img");
    const minDislikeImg = document.querySelector("#min-dislike-btn img");
    const maxLikeImg = document.querySelector("#max-like-btn img");
    const maxDislikeImg = document.querySelector("#max-dislike-btn img");

    if (minLikeImg) minLikeImg.src = assetLike;
    if (maxLikeImg) maxLikeImg.src = assetLike;
    if (minDislikeImg) minDislikeImg.src = assetDislike;
    if (maxDislikeImg) maxDislikeImg.src = assetDislike;

    if (userReactionKind === "like") {
      if (minLikeImg) minLikeImg.src = assetLikeConfirmed;
      if (maxLikeImg) maxLikeImg.src = assetLikeConfirmed;
    } else if (userReactionKind === "dislike") {
      if (minDislikeImg) minDislikeImg.src = assetDislikeConfirmed;
      if (maxDislikeImg) maxDislikeImg.src = assetDislikeConfirmed;
    }
  }

  function updatePlayStateIcons(isPlaying) {
    const minPlayerContainer = document.getElementById("au-player-minimized-container");
    const maxPlayerContainer = document.getElementById("player-full-screen");
    if (!minPlayerContainer) return;

    const playImg = document.getElementById("img-play-state");
    const maxBtn = document.getElementById("max-btn-play-toggle");
    const maxPlayBig = maxBtn ? maxBtn.querySelector("img") : null;
    const sideCommentsBtn = document.getElementById("max-comments-play-toggle");
    const sidePlayImg = sideCommentsBtn ? sideCommentsBtn.querySelector("img") : null;

    const minPlay = minPlayerContainer.getAttribute("data-img-min-play");
    const minPause = minPlayerContainer.getAttribute("data-img-min-pause");
    const maxPlay = maxPlayerContainer ? maxPlayerContainer.getAttribute("data-img-play") : "";
    const maxPause = maxPlayerContainer ? maxPlayerContainer.getAttribute("data-img-pause") : "";

    if (playImg) playImg.src = isPlaying ? minPause : minPlay;
    if (maxPlayBig) maxPlayBig.src = isPlaying ? maxPause : maxPlay;
    if (sidePlayImg) sidePlayImg.src = isPlaying ? maxPause : maxPlay;
  }


  // 1. ОБНОВЛЕННЫЙ СТАРТ ТРЕКА (сохраняет все данные трека в state)
  window.startAudioPlayback = function(trackData, playlistArray = []) {

    closeCommentsPanel();

    state.hasActiveTrack = true;
    state.currentTrack = trackData;
    const audio = document.getElementById("audio-core");
    const minPlayerContainer = document.getElementById("au-player-minimized-container");
    if (!audio || !minPlayerContainer) return;

    state.playlist = playlistArray.length > 0 ? playlistArray : [trackData];
    state.currentIndex = state.playlist.findIndex(t => t.id === trackData.id);
    if (state.currentIndex === -1) state.currentIndex = 0;

    minPlayerContainer.classList.remove("d-none");
    minPlayerContainer.style.setProperty("display", "flex", "important");

    document.getElementById("player-cover-img").src = trackData.cover_url || "";
    document.getElementById("player-title-txt").innerText = trackData.title.substring(0, 20) + (trackData.title.length > 20 ? "..." : "");
    document.getElementById("player-artists-txt").innerText = trackData.artists.substring(0, 30);

    document.getElementById("max-player-cover").src = trackData.cover_url || "";
    document.getElementById("max-player-title").innerText = trackData.title;
    document.getElementById("max-player-artists").innerText = trackData.artists;

    const cloneEl = document.getElementById("max-player-title-clone");
    if (cloneEl) cloneEl.innerText = trackData.title;
    renderPlayerArtists(trackData);
    setupMaxTitleMarquee();

    const maxLikeCount = document.getElementById("like-count-display");
    const mainCommentCount = document.getElementById("comment-count-display");

    if (maxLikeCount) maxLikeCount.innerText = trackData.likes_count;
    if (mainCommentCount) mainCommentCount.innerText = "0";
    updateReactionIcons(trackData.user_reaction);

    // 1. Сразу подгружаем количество комментариев из уже работающего эндпоинта комментариев
    fetch(`/tracks/${trackData.id}/comments`)
      .then(res => res.ok ? res.json() : null)
      .then(data => {
        if (!data || state.playlist[state.currentIndex]?.id !== trackData.id) return;
        if (mainCommentCount) {
          mainCommentCount.innerText = data.total_count_formatted ?? data.total_count ?? 0;
        }
      })
      .catch(() => {});

    // 2. Запрашиваем свежие лайки и реакцию текущего пользователя с сервера
    fetch(`/tracks/${trackData.id}/stats`)
      .then(res => res.ok ? res.json() : null)
      .then(stats => {
        if (!stats || state.playlist[state.currentIndex]?.id !== trackData.id) return;

        trackData.likes_count = stats.likes_count;
        trackData.user_reaction = stats.user_reaction;

        if (maxLikeCount) maxLikeCount.innerText = stats.likes_count;
        updateReactionIcons(stats.user_reaction);

        document.querySelectorAll(`.playable-track-card[data-id="${trackData.id}"]`).forEach(card => {
          card.setAttribute("data-likes-count", stats.likes_count);
          card.setAttribute("data-user-reaction", stats.user_reaction || "");
        });
      })
      .catch(() => {});

    if (state.reactionSubscription) state.reactionSubscription.unsubscribe();

    if (window.App && App.cable) {
      state.reactionSubscription = App.cable.subscriptions.create({
        channel: "TrackReactionsChannel",
        track_id: trackData.id
      }, {
        received(data) {
          if (maxLikeCount) maxLikeCount.innerText = data.likes_count;
          if (state.playlist[state.currentIndex]) {
            state.playlist[state.currentIndex].likes_count = data.likes_count;
          }
          document.querySelectorAll(`.playable-track-card[data-id="${trackData.id}"]`).forEach(card => {
            card.setAttribute("data-likes-count", data.likes_count);
          });
        }
      });
    }

    audio.src = trackData.audio_url;
    audio.play().then(() => updatePlayStateIcons(true)).catch(err => console.error(err));
  };

  window.playerNextTrack = function() {
    if (state.playlist.length <= 1) return;
    state.currentIndex = (state.currentIndex + 1) % state.playlist.length;
    window.startAudioPlayback(state.playlist[state.currentIndex], state.playlist);
  };

  window.playerPrevTrack = function() {
    if (state.playlist.length <= 1) return;
    state.currentIndex = (state.currentIndex - 1 + state.playlist.length) % state.playlist.length;
    window.startAudioPlayback(state.playlist[state.currentIndex], state.playlist);
  };

  window.playerToggleLike = function() {
    const track = state.playlist[state.currentIndex];
    if (!track) return;
    fetch("/tracks/" + track.id + "/reactions/toggle", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ kind: "like" })
    })
    .then(res => res.json())
    .then(data => { track.user_reaction = data.user_reaction; updateReactionIcons(data.user_reaction); });
  };

  window.playerToggleDislike = function() {
    const track = state.playlist[state.currentIndex];
    if (!track) return;
    fetch("/tracks/" + track.id + "/reactions/toggle", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ kind: "dislike" })
    })
    .then(res => res.json())
    .then(data => { track.user_reaction = data.user_reaction; updateReactionIcons(data.user_reaction); });
  };



    // Вспомогательная функция отрисовки авторов в виде ссылок
    function renderPlayerArtists(trackData) {
      const minArtistsEl = document.getElementById("player-artists-txt");
      const maxArtistsEl = document.getElementById("max-player-artists");
      let artistsList = [];

      try {
        if (trackData.artists_json) {
          artistsList = typeof trackData.artists_json === "string" 
            ? JSON.parse(trackData.artists_json) 
            : trackData.artists_json;
        }
      } catch (e) {}

      if (artistsList.length > 0) {
        const htmlLinks = artistsList.map(a => 
          `<a href="/user/${encodeURIComponent(a.username)}" class="artist-profile-link">${a.name}</a>`
        ).join(", ");
        if (minArtistsEl) minArtistsEl.innerHTML = htmlLinks;
        if (maxArtistsEl) maxArtistsEl.innerHTML = htmlLinks;
      } else {
        if (minArtistsEl) minArtistsEl.innerText = trackData.artists || "";
        if (maxArtistsEl) maxArtistsEl.innerText = trackData.artists || "";
      }
    }





  // --- ЕДИНЫЙ ГЛОБАЛЬНЫЙ ДЕЛЕГИРОВАННЫЙ ОБРАБОТЧИК КЛИКОВ ДЛЯ ВСЕХ СТРАНИЦ ---
    if (!window.auGlobalClickAttached) {
    window.auGlobalClickAttached = true;

    document.addEventListener("click", (e) => {
      const audio = document.getElementById("audio-core");

      // 1. Play / Pause
      if (e.target.closest("#btn-play-toggle") || e.target.closest("#max-btn-play-toggle") || e.target.closest("#max-comments-play-toggle")) {
        e.preventDefault();
        if (!audio || !audio.src) return;
        if (audio.paused) audio.play().catch(err => console.error(err));
        else audio.pause();
        return;
      }


      // 2. Следующий / Предыдущий трек
      if (e.target.closest(".js-player-next")) {
        e.preventDefault();
        window.playerNextTrack();
        return;
      }
      if (e.target.closest(".js-player-prev")) {
        e.preventDefault();
        window.playerPrevTrack();
        return;
      }

      // 3. Лайк / Дизлайк
      if (e.target.closest(".js-player-like")) {
        e.preventDefault();
        window.playerToggleLike();
        return;
      }
      if (e.target.closest(".js-player-dislike")) {
        e.preventDefault();
        window.playerToggleDislike();
        return;
      }

      // 4. Развернуть / Свернуть плеер
            // В обработчике #btn-maximize-player:
      if (e.target.closest("#btn-maximize-player")) {
        e.preventDefault();
        const maxPlayer = document.getElementById("player-full-screen");
        if (maxPlayer) {
          maxPlayer.classList.remove("d-none");
          maxPlayer.style.removeProperty("display");
        }
        document.body.classList.add("player-open");
        setupMaxTitleMarquee(); // Пересчитываем ширину и запускаем бегущую строку
        return;
      }


      if (e.target.closest("#btn-minimize-player")) {
        e.preventDefault();
        const maxPlayer = document.getElementById("player-full-screen");
        if (maxPlayer) maxPlayer.classList.add("d-none");
        document.body.classList.remove("player-open");
        return;
      }

      // 5. Перемотка по таймлайну
      const timeline = e.target.closest("#progress-timeline") || e.target.closest("#max-progress-timeline");
      if (timeline && audio && audio.duration) {
        const rect = timeline.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        audio.currentTime = Math.max(0, Math.min(1, clickX / rect.width)) * audio.duration;
        return;
      }

      // 6. Клик по карточке трека
      // Если кликнули по ссылке на профиль автора — позволяем Turbo перейти по ссылке, не перехватывая клик карточкой
      if (e.target.closest(".artist-profile-link")) {
        const maxPlayer = document.getElementById("player-full-screen");
        if (maxPlayer && !maxPlayer.classList.contains("d-none")) {
          maxPlayer.classList.add("d-none");
          document.body.classList.remove("player-open");
        }
        return;
      }

      const card = e.target.closest(".playable-track-card");
      if (card) {
        e.preventDefault();

        const clickedTrackData = {
          id: parseInt(card.getAttribute("data-id")),
          title: card.getAttribute("data-title"),
          artists: card.getAttribute("data-artists"),
          artists_json: card.getAttribute("data-artists-json"),
          audio_url: card.getAttribute("data-audio-url"),
          cover_url: card.getAttribute("data-cover-url"),
          likes_count: parseInt(card.getAttribute("data-likes-count")) || 0,
          user_reaction: card.getAttribute("data-user-reaction")
        };


        if (!clickedTrackData.audio_url) {
          alert("У этого трека отсутствует аудиофайл.");
          return;
        }

        const allCardsOnScreen = document.querySelectorAll(".playable-track-card");
        let otherTracks = Array.from(allCardsOnScreen).map(c => ({
          id: parseInt(c.getAttribute("data-id")),
          title: c.getAttribute("data-title"),
          artists: c.getAttribute("data-artists"),
          artists_json: c.getAttribute("data-artists-json"),
          audio_url: c.getAttribute("data-audio-url"),
          cover_url: c.getAttribute("data-cover-url"),
          likes_count: parseInt(c.getAttribute("data-likes-count")) || 0,
          user_reaction: c.getAttribute("data-user-reaction")
        })).filter(t => t.audio_url && t.id !== clickedTrackData.id);


        otherTracks = otherTracks.filter((track, index, self) =>
          index === self.findIndex((t) => t.id === track.id)
        );

        for (let i = otherTracks.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          const temp = otherTracks[i];
          otherTracks[i] = otherTracks[j];
          otherTracks[j] = temp;
        }

        window.startAudioPlayback(clickedTrackData, [clickedTrackData, ...otherTracks]);
      }

            // Открыть / закрыть / обновить комментарии
      if (e.target.closest("#max-comment-btn")) {
        e.preventDefault();
        openCommentsPanel();
        return;
      }
      if (e.target.closest("#btn-close-comments")) {
        e.preventDefault();
        closeCommentsPanel();
        return;
      }
      if (e.target.closest("#btn-refresh-comments")) {
        e.preventDefault();
        loadTrackComments();
        return;
      }

      // Сброс режима ответа ("ответ x")
      if (e.target.closest("#reply-mode-badge")) {
        e.preventDefault();
        replyingToCommentId = null;
        const badge = document.getElementById("reply-mode-badge");
        if (badge) badge.classList.add("d-none");
        return;
      }

      // Отправка нового комментария или ответа
      if (e.target.closest("#btn-submit-comment")) {
        e.preventDefault();
        submitNewComment();
        return;
      }

            // Отмена удаления комментария ("Не удалять")
      if (e.target.closest("#btn-cancel-delete-comment")) {
        e.preventDefault();
        pendingDeleteCommentId = null;
        const modal = document.getElementById("comment-delete-modal");
        if (modal) modal.classList.add("d-none");
        return;
      }

      // Подтверждение удаления комментария ("Да, удалить")
      if (e.target.closest("#btn-confirm-delete-comment")) {
        e.preventDefault();
        if (!pendingDeleteCommentId) return;
        const commentIdToDelete = pendingDeleteCommentId;
        pendingDeleteCommentId = null;

        const modal = document.getElementById("comment-delete-modal");
        if (modal) modal.classList.add("d-none");

        fetch(`/comments/${commentIdToDelete}`, {
          method: "DELETE",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').getAttribute("content")
          }
        })
        .then(res => {
          if (res.ok) loadTrackComments();
        })
        .catch(err => console.error("Ошибка удаления комментария:", err));
        return;
      }






    });
}






// --- ПРИВЯЗКА НАТИВНЫХ СОБЫТИЙ К ТЕГУ  ---
function bindAudioEvents() {
const audio = document.getElementById("audio-core");
if (!audio || audio.dataset.auEventsBound === "true") return;
audio.dataset.auEventsBound = "true";
audio.addEventListener("play", () => updatePlayStateIcons(true));
audio.addEventListener("pause", () => updatePlayStateIcons(false));
audio.addEventListener("ended", () => {
updatePlayStateIcons(false);
window.playerNextTrack();
});
audio.addEventListener("timeupdate", () => {
const duration = audio.duration || 0;
if (duration === 0) return;
const pct = (audio.currentTime / duration) * 100;
const currentProgress = document.getElementById("progress-current");
const progressPin = document.getElementById("progress-pin");
const maxCurrentProgress = document.getElementById("max-progress-current");
if (currentProgress) currentProgress.style.width = pct + "%";
if (progressPin) progressPin.style.left = pct + "%";
if (maxCurrentProgress) maxCurrentProgress.style.width = pct + "%";
const minCur = document.getElementById("time-current");
const maxCur = document.getElementById("max-time-current");
if (minCur) minCur.innerText = formatTime(audio.currentTime);
if (maxCur) maxCur.innerText = formatTime(audio.currentTime);
});
audio.addEventListener("loadedmetadata", () => {
const durationText = formatTime(audio.duration);
const minDur = document.getElementById("time-duration");
const maxDur = document.getElementById("max-time-duration");
if (minDur) minDur.innerText = durationText;
if (maxDur) maxDur.innerText = durationText;
});
audio.addEventListener("progress", () => {
if (audio.duration > 0 && audio.buffered.length > 0) {
const bufferedPct = (audio.buffered.end(audio.buffered.length - 1) / audio.duration) * 100;
const minBuf = document.getElementById("progress-buffered");
const maxBuf = document.getElementById("max-player-buffered");
if (minBuf) minBuf.style.width = bufferedPct + "%";
if (maxBuf) maxBuf.style.width = bufferedPct + "%";
}
});
}
    // 2. ОБНОВЛЕННОЕ ВОССТАНОВЛЕНИЕ ПРИ ПЕРЕХОДАХ
  function handlePageLoad() {
    const minPlayer = document.getElementById("au-player-minimized-container");
    const maxPlayer = document.getElementById("player-full-screen");
    const audio = document.getElementById("audio-core");

    if (!minPlayer) {
      if (audio) { audio.pause(); audio.src = ""; }
      state.hasActiveTrack = false;
      state.currentTrack = null;
      return;
    }

    document.body.classList.remove("player-open");
    bindAudioEvents();

    const isUploadPage = window.location.pathname === "/tracks/new" || !!document.getElementById("music-form");

    if (isUploadPage) {
      if (audio) {
        state.savedTime = audio.currentTime || 0;
        if (!audio.paused) audio.pause();
      }
      minPlayer.classList.add("d-none");
      minPlayer.style.setProperty("display", "none", "important");
      if (maxPlayer) maxPlayer.classList.add("d-none");
    } 
    else if (state.hasActiveTrack && state.currentTrack) {
      // Возвращаем плеер на экран независимо от того, успел ли Turbo сбросить DOM
      minPlayer.classList.remove("d-none");
      minPlayer.style.setProperty("display", "flex", "important");

      // Если тег <audio> был пересоздан Turbo, восстанавливаем трек и секунду из памяти
      if (audio && (!audio.src || audio.src === window.location.href)) {
        const trackData = state.currentTrack;
        document.getElementById("player-cover-img").src = trackData.cover_url || "";
        document.getElementById("player-title-txt").innerText = trackData.title.substring(0, 20) + (trackData.title.length > 20 ? "..." : "");
        document.getElementById("player-artists-txt").innerText = trackData.artists.substring(0, 30);
        document.getElementById("max-player-cover").src = trackData.cover_url || "";
        document.getElementById("max-player-title").innerText = trackData.title;
        document.getElementById("max-player-artists").innerText = trackData.artists;

        const cloneEl = document.getElementById("max-player-title-clone");
        if (cloneEl) cloneEl.innerText = trackData.title;

        renderPlayerArtists(trackData);
        setupMaxTitleMarquee();

        updateReactionIcons(trackData.user_reaction);

        audio.src = trackData.audio_url;
        audio.addEventListener("loadedmetadata", () => {
          if (state.savedTime) audio.currentTime = state.savedTime;
        }, { once: true });
      }

      updatePlayStateIcons(audio ? !audio.paused : false);
    }
  }

  handlePageLoad();
  document.addEventListener("turbo:render", handlePageLoad);


  document.addEventListener("turbo:before-cache", () => {
    const maxPlayer = document.getElementById("player-full-screen");
    if (maxPlayer) maxPlayer.classList.add("d-none");
    document.body.classList.remove("player-open");
  });

  document.addEventListener("DOMContentLoaded", handlePageLoad);
  document.addEventListener("turbo:load", handlePageLoad);


//КУСОК ДЛЯ БЕГУЩЕЙ СТРОКИ НАЗВАНИЯ
  let marqueeTimer = null;
  let marqueeAnimFrame = null;

  function stopTitleMarquee() {
    if (marqueeTimer) clearTimeout(marqueeTimer);
    if (marqueeAnimFrame) cancelAnimationFrame(marqueeAnimFrame);
    const trackEl = document.getElementById("max-marquee-track");
    if (trackEl) trackEl.style.transform = "translateX(0px)";
  }

  function setupMaxTitleMarquee() {
    stopTitleMarquee();
    const box = document.getElementById("max-title-marquee-box");
    const trackEl = document.getElementById("max-marquee-track");
    const titleEl = document.getElementById("max-player-title");
    const cloneEl = document.getElementById("max-player-title-clone");
    if (!box || !trackEl || !titleEl || !cloneEl) return;

    const rawText = titleEl.textContent || "";
    const trimmedText = rawText.replace(/^\s+/, ""); // Убираем пробелы в начале, чтобы первая буква была непробельной
    titleEl.textContent = trimmedText;
    cloneEl.textContent = "";

    // Если текст помещается в одну строку — прокрутка не нужна
    if (titleEl.offsetWidth <= box.clientWidth) return;

    // Включаем копию текста для бесшовного кругового движения
    cloneEl.textContent = trimmedText;

    // Точное расстояние одного полного круга (ширина оригинала + левый отступ клона 60px)
    const cloneStyle = window.getComputedStyle(cloneEl);
    const gapPx = parseFloat(cloneStyle.paddingLeft) || 60;
    const cycleDistance = titleEl.offsetWidth + gapPx;

    const speedPxPerSec = 50; // Скорость движения
    const pauseDelayMs = 2500; // Задержка в начале строки перед стартом

    function runCycle() {
      trackEl.style.transform = "translateX(0px)";

      marqueeTimer = setTimeout(() => {
        let startTime = null;
        const durationMs = (cycleDistance / speedPxPerSec) * 1000;

        function step(timestamp) {
          if (!startTime) startTime = timestamp;
          const elapsed = timestamp - startTime;
          const progress = Math.min(elapsed / durationMs, 1);

          // Сдвигаем трек влево до тех пор, пока первая буква клона не встанет ровно на место первой буквы оригинала
          trackEl.style.transform = `translateX(-${progress * cycleDistance}px)`;

          if (progress < 1) {
            marqueeAnimFrame = requestAnimationFrame(step);
          } else {
            runCycle();
          }
        }

        marqueeAnimFrame = requestAnimationFrame(step);
      }, pauseDelayMs);
    }

    runCycle();
  }








  // --- ЛОГИКА РАЗДЕЛА КОММЕНТАРИЕВ В РАЗВЕРНУТОМ ПЛЕЕРЕ ---
     // --- ЕДИНЫЙ МОДУЛЬ РАЗДЕЛА КОММЕНТАРИЕВ ---
  let replyingToCommentId = null;
  let pendingDeleteCommentId = null;

  function openCommentsPanel() {
    const infoBox = document.getElementById("max-track-details-view");
    const commentsPanel = document.getElementById("max-comments-view");
    const leftCol = document.getElementById("max-left-column");
    const controlsRow = document.getElementById("max-controls-row");

    if (leftCol && controlsRow) {
      leftCol.appendChild(controlsRow);
    }

    if (infoBox) {
      infoBox.classList.add("d-none");
      infoBox.style.setProperty("display", "none", "important");
    }
    if (commentsPanel) {
      commentsPanel.classList.remove("d-none");
      commentsPanel.style.setProperty("display", "flex", "important");
    }

    resetCommentInput();
    loadTrackComments();
  }

  function closeCommentsPanel() {
    const infoBox = document.getElementById("max-track-details-view");
    const commentsPanel = document.getElementById("max-comments-view");
    const controlsRow = document.getElementById("max-controls-row");

    if (infoBox && controlsRow) {
      infoBox.appendChild(controlsRow);
    }

    if (commentsPanel) {
      commentsPanel.classList.add("d-none");
      commentsPanel.style.setProperty("display", "none", "important");
    }
    if (infoBox) {
      infoBox.classList.remove("d-none");
      infoBox.style.removeProperty("display");
    }
  }

  function resetCommentInput() {
    replyingToCommentId = null;
    const badge = document.getElementById("reply-mode-badge");
    const textarea = document.getElementById("comment-textarea");
    const submitBtn = document.getElementById("btn-submit-comment");

    if (badge) badge.classList.add("d-none");
    if (textarea) {
      textarea.value = "";
      textarea.style.height = "22px";
    }
    if (submitBtn) submitBtn.disabled = true;
  }

  function renderCommentBodyWithMentions(containerEl, rawText) {
    containerEl.innerHTML = "";
    const mentionRegex = /(@[a-zA-Z0-9_.-]+)/g;
    const parts = rawText.split(mentionRegex);

    parts.forEach(part => {
      if (part.startsWith("@") && part.length > 1) {
        const username = part.slice(1).toLowerCase();
        const link = document.createElement("a");
        link.href = `/user/${encodeURIComponent(username)}`;
        link.className = "comment-mention-link artist-profile-link";
        link.textContent = part;
        containerEl.appendChild(link);
      } else {
        containerEl.appendChild(document.createTextNode(part));
      }
    });
  }

  function loadTrackComments() {
    const track = state.playlist[state.currentIndex];
    const listContainer = document.getElementById("comments-list-container");
    if (!track || !listContainer) return;

    listContainer.innerHTML = `<div style="color:#8aa0b5; text-align:center; padding:20px;">Загрузка комментариев...</div>`;

    fetch(`/tracks/${track.id}/comments`)
      .then(res => res.json())
      .then(data => {
        const countValue = data.total_count_formatted ?? data.total_count ?? 0;
        const headerTotal = document.getElementById("comments-panel-count");
        const mainCounter = document.getElementById("comment-count-display");

        if (headerTotal) headerTotal.innerText = countValue;
        if (mainCounter) mainCounter.innerText = countValue;

        listContainer.innerHTML = "";
        const comments = data.comments || [];

        if (comments.length === 0) {
          listContainer.innerHTML = `<div style="color:#8aa0b5; text-align:center; padding:30px;">Комментариев пока нет. Будьте первыми!</div>`;
          return;
        }

        comments.forEach(comment => {
          listContainer.appendChild(buildCommentThreadElement(comment));
        });
      })
      .catch(err => console.error("Ошибка загрузки комментариев:", err));
  }

  function buildCommentCardElement(comment, isReply, rootCommentId) {
    const commentsView = document.getElementById("max-comments-view");
    const minPlayer = document.getElementById("au-player-minimized-container");
    const likeIcon = commentsView?.getAttribute("data-like-icon") || minPlayer?.getAttribute("data-img-like");
    const likeConfirmedIcon = commentsView?.getAttribute("data-like-confirmed-icon") || minPlayer?.getAttribute("data-img-like-confirmed");
    
    const trashIcon = commentsView?.getAttribute("data-trash-icon") || "";
    const deleteBtnHtml = comment.can_delete
      ? `<button type="button" class="comment-delete-btn" title="Удалить комментарий"><img src="${trashIcon}" alt="Удалить"></button>`
      : "";


    const isLiked = Boolean(comment.liked_by_me || comment.liked);

    const card = document.createElement("div");
    card.className = "comment-item-card" + (isReply ? " is-reply" : "");
    card.dataset.commentId = comment.id;

    const avatarHtml = comment.avatar_url
      ? `<img src="${comment.avatar_url}" alt="" class="comment-avatar">`
      : `<div class="comment-avatar"></div>`;

    card.innerHTML = `
      ${avatarHtml}
      <div class="comment-content-col">
        <div class="comment-meta-row">
          <a href="/user/${encodeURIComponent(comment.username)}" class="comment-author-link artist-profile-link">${escapeHtml(comment.username)}</a>
          <span class="comment-time-txt">${escapeHtml(comment.time_ago)}</span>
        </div>
        <div class="comment-body-wrapper">
          <div class="comment-body-text"></div>
        </div>
        <div class="comment-actions-row">
          <button type="button" class="comment-reply-btn">Ответить</button>
          <button type="button" class="comment-like-btn">
            <img src="${isLiked ? likeConfirmedIcon : likeIcon}" alt="Like">
            <span class="comment-like-count">${comment.formatted_likes ?? comment.likes_count ?? 0}</span>
          </button>
          ${deleteBtnHtml}
        </div>
      </div>
    `;

    const bodyEl = card.querySelector(".comment-body-text");
    renderCommentBodyWithMentions(bodyEl, comment.body);

    requestAnimationFrame(() => {
      const lineHeight = parseFloat(window.getComputedStyle(bodyEl).lineHeight) || 21;
      if (bodyEl.scrollHeight > lineHeight * 3 + 4) {
        bodyEl.classList.add("clamped");
        const expandBtn = document.createElement("button");
        expandBtn.type = "button";
        expandBtn.className = "comment-expand-btn";
        expandBtn.innerText = "раскрыть";
        expandBtn.addEventListener("click", () => {
          bodyEl.classList.remove("clamped");
          expandBtn.remove();
        });
        card.querySelector(".comment-body-wrapper").appendChild(expandBtn);
      }
    });

    card.querySelector(".comment-reply-btn").addEventListener("click", () => {
      const textarea = document.getElementById("comment-textarea");
      const badge = document.getElementById("reply-mode-badge");
      if (!textarea || textarea.disabled) return;

      replyingToCommentId = rootCommentId;
      if (badge) badge.classList.remove("d-none");

      const mention = `@${comment.username} `;
      if (!textarea.value.startsWith(mention)) {
        textarea.value = mention + textarea.value;
      }
      textarea.focus();
      autoResizeCommentTextarea(textarea);
    });

    const likeBtn = card.querySelector(".comment-like-btn");
    likeBtn.addEventListener("click", () => {
      fetch(`/comments/${comment.id}/toggle_like`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').getAttribute("content")
        }
      })
      .then(res => {
        if (res.status === 401) { alert("Войдите в аккаунт, чтобы оценивать комментарии."); return null; }
        return res.json();
      })
      .then(data => {
        if (!data) return;
        likeBtn.querySelector("img").src = data.liked ? likeConfirmedIcon : likeIcon;
        likeBtn.querySelector(".comment-like-count").innerText = data.formatted_likes ?? data.likes_count;
      });
    });


        const deleteBtn = card.querySelector(".comment-delete-btn");
    if (deleteBtn) {
      deleteBtn.addEventListener("click", () => {
        pendingDeleteCommentId = comment.id;
        const subtitleEl = document.getElementById("comment-delete-subtitle");
        if (subtitleEl) {
          subtitleEl.innerText = !isReply
            ? "Также будут удалены все ответы на него. Отменить действие будет невозможно."
            : "Отменить действие будет невозможно.";
        }
        const modal = document.getElementById("comment-delete-modal");
        if (modal) modal.classList.remove("d-none");
      });
    }



    return card;
  }

  function buildCommentThreadElement(comment) {
    const thread = document.createElement("div");
    thread.className = "comment-thread";
    thread.dataset.rootId = comment.id;

    thread.appendChild(buildCommentCardElement(comment, false, comment.id));

    const repliesContainer = document.createElement("div");
    repliesContainer.className = "comment-replies-list d-none";
    thread.appendChild(repliesContainer);

    const replies = comment.replies || [];
    if (replies.length > 0) {
      let isExpanded = false;
      const toggleRepliesBtn = document.createElement("button");
      toggleRepliesBtn.type = "button";
      toggleRepliesBtn.className = "view-replies-btn";
      toggleRepliesBtn.innerText = `Посмотреть ответы(${replies.length})`;

      toggleRepliesBtn.addEventListener("click", () => {
        if (!isExpanded) {
          repliesContainer.innerHTML = "";
          replies.forEach(reply => {
            repliesContainer.appendChild(buildCommentCardElement(reply, true, comment.id));
          });
          repliesContainer.classList.remove("d-none");
          toggleRepliesBtn.innerText = "Скрыть ответы";
          thread.appendChild(toggleRepliesBtn);
          isExpanded = true;
        } else {
          repliesContainer.classList.add("d-none");
          repliesContainer.innerHTML = "";
          toggleRepliesBtn.innerText = `Посмотреть ответы(${replies.length})`;
          isExpanded = false;
        }
      });

      thread.appendChild(toggleRepliesBtn);
    }

    return thread;
  }

  function autoResizeCommentTextarea(textarea) {
    textarea.style.height = "22px";
    const newHeight = Math.min(textarea.scrollHeight, 66);
    textarea.style.height = newHeight + "px";

    const submitBtn = document.getElementById("btn-submit-comment");
    if (submitBtn) {
      submitBtn.disabled = textarea.value.trim().length === 0;
    }
  }

  function submitNewComment() {
    const track = state.playlist[state.currentIndex];
    const textarea = document.getElementById("comment-textarea");
    const submitBtn = document.getElementById("btn-submit-comment");
    if (!track || !textarea || textarea.value.trim().length === 0) return;

    submitBtn.disabled = true;

    fetch(`/tracks/${track.id}/comments`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').getAttribute("content")
      },
      body: JSON.stringify({
        body: textarea.value.trim(),
        parent_id: replyingToCommentId
      })
    })
.then(res => res.json())
.then(data => {
if (data.errors) {
alert(data.errors.join("\n"));
submitBtn.disabled = false;
return;
}
resetCommentInput();
loadTrackComments();
})
.catch(err => {
console.error(err);
submitBtn.disabled = false;
});
}
function escapeHtml(str) {
const div = document.createElement("div");
div.textContent = str;
return div.innerHTML;
}
document.addEventListener("input", (e) => {
if (e.target && e.target.id === "comment-textarea") {
autoResizeCommentTextarea(e.target);
}
});
document.addEventListener("keydown", (e) => {
if (e.target && e.target.id === "comment-textarea" && e.key === "Enter" && !e.shiftKey) {
e.preventDefault();
submitNewComment();
}
});
})();
</script>
