<header class="site-header">
  <!-- 1. Логотип -->
  <!-- Логотип обернут в ссылку на главную страницу -->
  <%= link_to root_path, class: "LogoText" do %>
    <span class="brand-au">AU</span><span class="brand-music">Music</span>
  <% end %>
  
  <!-- 2. Форма поиска музыки -->
  <%= form_with url: "#", method: :get, class: "search-container" do |form| %>
    <%= form.text_field :query, placeholder: "искать...", class: "search-input" %>
    <button type="submit" class="search-submit-btn">
      <%= image_tag "search-icon.png", alt: "Найти", class: "search-icon" %>
    </button>
  <% end %>

  <!-- 3. Правый блок (Авторизация / Сессия) -->
  <% if logged_in? %>
    <div class="header-right-block">
      
      <!-- Кнопка "+" видна только Владельцу и Музыканту -->
      <% if current_user.can_upload_music? %>
        <%= link_to "+",  new_track_path, class: "create-music-btn", title: "Загрузить музыку" %>
      <% end %>

      <!-- Капсула сессии пользователя -->
      <div class="user-session-block">
        <span class="session-username"><%= mask_username(current_user.username) %></span>
        <%= button_to "Выйти", logout_path, method: :delete, form_class: "logout-form-wrapper", class: "logout-button" %>
      </div>
      
    </div>
  <% else %>
    <!-- Если пользователь гость -->
    <%= link_to "Войти", signin_path, class: "login-button" %>
  <% end %>
</header>

<main class="main-content">
  <div class="tracks-grid" id="tracks-infinite-container" data-page="1">
    <%= render "track_cards", tracks: @tracks %>
  </div>
  
  <!-- Индикатор загрузки -->
  <div class="scroll-loader d-none" id="infinite-loader">Загрузка треков...</div>
</main>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const container = document.getElementById("tracks-infinite-container");
  const loader = document.getElementById("infinite-loader");
  
  let isLoading = false;
  let hasMoreTracks = true;

  window.addEventListener("scroll", () => {
    if (isLoading || !hasMoreTracks) return;

    // Проверяем, доскроллил ли пользователь до низа страницы (с запасом в 200px)
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 200) {
      loadMoreTracks();
    }
  });

  function loadMoreTracks() {
    isLoading = true;
    loader.classList.remove("d-none");

    const currentPage = parseInt(container.getAttribute("data-page"));
    const nextPage = currentPage + 1;

    // Формируем AJAX-запрос к контроллеру Rails
    fetch(`/?page=${nextPage}`, {
      headers: {
        "X-Requested-With": "XMLHttpRequest"
      }
    })
    .then(response => response.text())
    .then(html => {
      if (html.trim().length === 0) {
        hasMoreTracks = false; // Если сервер прислал пустой ответ, треков больше нет
      } else {
        container.insertAdjacentHTML("beforeend", html);
        container.setAttribute("data-page", nextPage); // Обновляем номер страницы
      }
    })
    .catch(error => console.error("Ошибка загрузки треков:", error))
    .finally(() => {
      isLoading = false;
      loader.classList.add("d-none");
    });
  }
});
</script>
