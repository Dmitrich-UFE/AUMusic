<%= stylesheet_link_tag "sign-styles", media: "all" %>

<header class="sign-header">
  <%= link_to root_path, class: "LogoText" do %>
    <span class="brand-au">AU</span><span class="brand-music">Music</span>
  <% end %>
</header>

<main class="sign-container">
  <h1 class="sign-title">Регистрация</h1>

  <!-- Привязываем форму к объекту @user и меняем URL на создание -->
  <%= form_with model: @user, url: signin_path, method: :post, class: "sign-form" do |form| %>
    
      <!-- Блок вывода ошибок (Исправленный) -->
  <% if @user.errors.any? %>
    <div class="error-messages" style="color: #EA5455; font-family: 'Merriweather', serif; font-size: 16px; margin-bottom: 20px; text-align: center;">
      <% @user.errors.objects.each do |error| %>
        <div><%= error.message %></div>
      <% end %>
    </div>
  <% end %>



    <div class="form-group">
      <%= form.text_field :login, placeholder: "Никнейм или Email", class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.password_field :password, placeholder: "Пароль", class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.password_field :password_confirmation, placeholder: "Подтверждение пароля", class: "form-input" %>
    </div>

    <%= form.submit "Зарегистрироваться", class: "sign-submit-btn" %>
  <% end %>
</main>
