<!DOCTYPE html>
<html>
  <head>
    <title>AUMusic</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    
    <% unless controller_name == "sessions" %>
      <%= stylesheet_link_tag "player-styles", "data-turbo-track": "reload" %>
      <%= javascript_include_tag "actioncable", "data-turbo-track": "reload" %>
      <%= javascript_include_tag "turbo", type: "module" %>
      <%= render "shared/player_script" %>
    <% end %>
  </head>

  <body>
    <%= yield %>

    <% unless controller_name == "sessions" %>
      <%= render "shared/player" %>
    <% end %>
  </body>
</html>
