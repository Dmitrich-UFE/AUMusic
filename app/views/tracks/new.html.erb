<%= stylesheet_link_tag "create-music-styles", media: "all" %>

<header class="site-header">
  <%= link_to root_path, class: "LogoText" do %>
    <span class="brand-au">AU</span><span class="brand-music">Music</span>
  <% end %>
  <div class="header-right-block">
    <div class="user-session-block">
      <span class="session-username"><%= mask_username(current_user.username) %></span>
      <%= button_to "Выйти", logout_path, method: :delete, form_class: "logout-form-wrapper", class: "logout-button" %>
    </div>
  </div>
</header>

<main class="upload-container">
  
  <%= form_with url: "#", method: :post, class: "upload-form", id: "music-form" do |form| %>
  
    <!-- Левая колонка: медиа -->
    <div class="form-column media-upload">
      <div class="drop-zone" id="cover-drop-zone">
        <span class="drop-zone-text">Фото<br>сюда</span>
        <%= form.file_field :cover, id: "cover-file-input", accept: ".jpg,.jpeg,.png,.webp", style: "display:none;" %>
      </div>
      <p class="upload-hint" id="cover-hint">Загрузите фото обложки в формате .png или .jpg размером до 5 Mb</p>

      <div class="drop-zone audio-zone" id="audio-drop-zone">
        <span class="drop-zone-text">Перетащите<br>музыку сюда</span>
        <%= form.file_field :audio, id: "audio-file-input", accept: ".mp3,.flac,.ogg", style: "display:none;" %>
      </div>
    </div>

    <!-- Правая колонка: текст и соавторы -->
    <div class="form-column meta-info">
      <div class="input-group">
        <%= form.text_field :title, placeholder: "Название композиции до 50 символов...", class: "text-input", maxlength: 50 %>
      </div>
      
      <div class="input-group">
        <%= form.text_area :description, placeholder: "Описание до 150 символов...", class: "text-input textarea-input", maxlength: 150 %>
      </div>

      <!-- Секция авторов на странице -->
      <div class="authors-section">
        <h3 class="section-title">Авторы</h3>
        <div class="authors-list" id="authors-container">
          <div class="author-item primary-author" data-username="<%= current_user.username %>">
            <span class="author-name"><%= current_user.username %> (Вы)</span>
          </div>
        </div>
        <button type="button" class="btn btn-add-author" id="open-search-modal-btn">Добавить автора</button>
      </div>

      <!-- Кнопка публикации композиции -->
      <%= form.submit "Опубликовать композицию", class: "btn btn-submit", id: "submit-track-btn", disabled: true %>
    </div>

  <% end %> <!-- Конец формы -->

</main>

<!-- МОДАЛЬНОЕ ОКНО ВЫНЕСЕНО СЮДА (За пределы главного контейнера и формы) -->
<div class="modal-overlay d-none" id="search-modal">
  <div class="modal-window">
    
    <div class="modal-header">
      <h2 class="modal-title">Добавить автора</h2>
      <button type="button" class="modal-close-btn" id="close-search-modal-btn">
        <%= image_tag "x-icon.png", alt: "Закрыть", class: "close-icon" %>
      </button>
    </div>

    <div class="modal-search-box">
      <button type="button" class="modal-search-submit" id="modal-search-btn">
        <%= image_tag "search-icon.png", alt: "Искать", class: "search-icon" %>
      </button>
      <input type="text" placeholder="искать пользователя..." class="modal-search-input" id="modal-search-input">
    </div>

    <!-- Область результатов: изначально пустая -->
    <div class="modal-results-scroll">
      <div class="modal-results-grid" id="modal-search-results"></div>
    </div>

  </div>
</div>


<script>
document.addEventListener("DOMContentLoaded", () => {
  // --- ЭЛЕМЕНТЫ СТРАНИЦЫ ЗАГРУЗКИ ---
  const submitBtn = document.getElementById("submit-track-btn");
  const descriptionInput = document.querySelector(".textarea-input");
  const audioDropZone = document.getElementById("audio-drop-zone");
  const audioInput = document.getElementById("audio-file-input");
  const coverDropZone = document.getElementById("cover-drop-zone");
  const coverInput = document.getElementById("cover-file-input");
  const authorsContainer = document.getElementById("authors-container");

  // --- ЭЛЕМЕНТЫ МОДАЛЬНОГО ОКНА ---
  const modal = document.getElementById("search-modal");
  const openModalBtn = document.getElementById("open-search-modal-btn");
  const closeModalBtn = document.getElementById("close-search-modal-btn");
  const searchInput = document.getElementById("modal-search-input");
  const searchBtn = document.getElementById("modal-search-btn");
  const resultsGrid = document.getElementById("modal-search-results");

  const MAX_AUTHORS = 10;
  let hasDescription = false;
  let hasCover = false;
  let hasAudio = false;

  // --- ЛОГИКА ВАЛИДАЦИИ ФОРМЫ ---
  function checkFormValidity() {
    hasDescription = descriptionInput.value.trim().length > 0;

    if (hasDescription && hasCover && hasAudio) {
      submitBtn.disabled = false;
      submitBtn.classList.add("active");
    } else {
      submitBtn.disabled = true;
      submitBtn.classList.remove("active");
    }
  }

  descriptionInput.addEventListener("input", checkFormValidity);

  // --- ФУНКЦИЯ ДЛЯ ЗАГРУЗКИ АУДИО ---
  function validateAndSetAudio(filesList) {
    const file = filesList[0];
    if (!file) return;

    const allowedExtensions = /(\.mp3|\.flac|\.ogg)$/i;
    if (!allowedExtensions.exec(file.name)) {
      alert("Неверный формат аудио. Принимаются только .mp3, .flac, .ogg");
      hasAudio = false;
      checkFormValidity();
      return;
    }
    
    let fileName = file.name;
    if (fileName.length > 24) {
      fileName = fileName.substring(0, 10) + "..." + fileName.substring(fileName.length - 12);
    }
    audioDropZone.querySelector(".drop-zone-text").innerHTML = fileName;
    
    hasAudio = true;
    checkFormValidity();
  }

  // --- ФУНКЦИЯ ДЛЯ ЗАГРУЗКИ ОБЛОЖКИ ---
  function validateAndSetCover(filesList) {
    const file = filesList[0];
    if (!file) return;

    const allowedExtensions = /(\.jpg|\.jpeg|\.png|\.webp)$/i;
    const maxSize = 5 * 1024 * 1024;
    const coverHint = document.getElementById("cover-hint");
    const coverText = coverDropZone.querySelector(".drop-zone-text");

    coverHint.classList.remove("error");
    coverHint.innerText = "Загрузите фото обложки в формате .png или .jpg размером до 5 Mb";

    if (!allowedExtensions.exec(file.name)) {
      const ext = file.name.substring(file.name.lastIndexOf("."));
      coverHint.classList.add("error");
      coverHint.innerText = `Неверный формат: ${ext}. Принимаются: .jpg, .jpeg, .png, .webp.`;
      hasCover = false;
      checkFormValidity();
      return;
    }

    if (file.size > maxSize) {
      coverHint.classList.add("error");
      coverHint.innerText = "Превышен размер файла. Сожмите его и попробуйте снова.";
      hasCover = false;
      checkFormValidity();
      return;
    }

    const img = new Image();
    img.src = URL.createObjectURL(file);
    img.onload = function() {
      if (this.width !== this.height) {
        coverHint.classList.add("error");
        coverHint.innerText = "Для обложки следует использовать изображения формата 1:1";
        hasCover = false;
        checkFormValidity();
        return;
      }

      coverDropZone.style.backgroundImage = `url('${img.src}')`;
      coverText.style.display = "none";
      
      hasCover = true;
      checkFormValidity();
    };
  }

  // --- ПРИВЯЗКА СОБЫТИЙ МЕДИАЗОН ---
  audioDropZone.addEventListener("click", () => audioInput.click());
  coverDropZone.addEventListener("click", () => coverInput.click());

  audioInput.addEventListener("change", () => validateAndSetAudio(audioInput.files));
  coverInput.addEventListener("change", () => validateAndSetCover(coverInput.files));

  [audioDropZone, coverDropZone].forEach(zone => {
    zone.addEventListener("dragover", (e) => { e.preventDefault(); zone.classList.add("drag-over"); });
    zone.addEventListener("dragleave", () => zone.classList.remove("drag-over"));
  });

  audioDropZone.addEventListener("drop", (e) => {
    e.preventDefault();
    audioDropZone.classList.remove("drag-over");
    validateAndSetAudio(e.dataTransfer.files);
  });

  coverDropZone.addEventListener("drop", (e) => {
    e.preventDefault();
    coverDropZone.classList.remove("drag-over");
    validateAndSetCover(e.dataTransfer.files);
  });


  // --- ЛОГИКА МОДАЛЬНОГО ОКНА АВТОРОВ ---

  // Функция обновления текста и видимости кнопки
  function updateAddAuthorButton() {
    const currentCount = authorsContainer.querySelectorAll(".author-item").length;
    const left = MAX_AUTHORS - currentCount;
    
    if (left <= 0) {
      openModalBtn.style.display = "none";
    } else {
      openModalBtn.style.display = "flex";
      if (currentCount > 1) {
        openModalBtn.innerText = `Добавить автора (осталось ${left})`;
      } else {
        openModalBtn.innerText = "Добавить автора";
      }
    }
  }

  // Управление открытием и закрытием окна
  openModalBtn.addEventListener("click", (e) => {
    e.preventDefault();
    modal.classList.remove("d-none");
    searchInput.focus();
  });

  closeModalBtn.addEventListener("click", (e) => {
    e.preventDefault();
    modal.classList.add("d-none");
    resultsGrid.innerHTML = ""; 
    searchInput.value = "";
  });

  // База данных пользователей для имитации поиска
  const mockUsersDb = [
    "123s1mple", "gepplalla", "undabarfaultens", "music_maker", 
    "alex_sound", "sound_producer", "guitar_hero", "piano_man", 
    "dj_drop", "vocal_queen", "beat_king", "rap_star", "sound_ninja"
  ];

  // Функция поиска
  function performSearch() {
    const query = searchInput.value.trim().toLowerCase();
    resultsGrid.innerHTML = ""; 
    
    if (!query) return;

    const filteredUsers = mockUsersDb
      .filter(user => user.toLowerCase().includes(query))
      .slice(0, 10);

    filteredUsers.forEach(username => {
      const isAlreadyAdded = !!authorsContainer.querySelector(`[data-username="${username}"]`);
      
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "result-user-btn";
      
      if (isAlreadyAdded) {
        btn.style.opacity = "0.4";
        btn.style.cursor = "not-allowed";
      }
      
      btn.innerText = username;
      
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        if (isAlreadyAdded) return;
        
        addAuthorRow(username);
        modal.classList.add("d-none"); 
        searchInput.value = "";
        resultsGrid.innerHTML = "";
      });
      
      resultsGrid.appendChild(btn);
    });
  }

  searchInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      performSearch();
    }
  });
  searchBtn.addEventListener("click", (e) => {
    e.preventDefault();
    performSearch();
  });

  // Добавление строки соавтора с рабочей иконкой корзины
  function addAuthorRow(username) {
    const currentCount = authorsContainer.querySelectorAll(".author-item").length;
    if (currentCount >= MAX_AUTHORS) return;

    const authorDiv = document.createElement("div");
    authorDiv.className = "author-item";
    authorDiv.setAttribute("data-username", username);

    authorDiv.innerHTML = `
      <span class="author-name">${username}</span>
      <button type="button" class="btn-remove-author" title="Удалить соавтора">
        <img src="/assets/trashcan-icon.png" alt="Удалить" class="trashcan-icon">
      </button>
    `;

    authorDiv.querySelector(".btn-remove-author").addEventListener("click", (e) => {
      e.preventDefault();
      authorDiv.remove();
      updateAddAuthorButton();
    });

    authorsContainer.appendChild(authorDiv);
    updateAddAuthorButton();
  }
});
</script>
